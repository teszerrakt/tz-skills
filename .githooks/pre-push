#!/bin/sh
# Lint and unit tests, then the eval cases of every skill the pushed branch changes or affects.
# Evals run on this machine's Claude login and take minutes; `git push --no-verify` skips the hook.
# A run refused only for quota warns and lets the push through; a failed case still blocks.
set -e
cd "$(git rev-parse --show-toplevel)"
bun run lint:skills
bun run check:versions
bun test
bun run evals
