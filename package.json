{
  "name": "@teszerrakt/skills",
  "version": "0.1.0",
  "description": "Personal Claude Code skills — frontend design-doc pipeline (fe-design-map, ask-stakeholders, estimate-effort, fe-design-cleanup), PR review (address-review), standup drafting. Installs via bunx.",
  "type": "module",
  "bin": {
    "tz-skills": "./bin/install.ts"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "scripts": {
    "setup": "bun run setup.ts",
    "uninstall": "bun run setup.ts --uninstall",
    "typecheck": "tsc --noEmit",
    "test": "bun test ship-epic",
    "lint": "oxlint ship-epic/command-center ship-epic/scripts",
    "format": "oxfmt 'ship-epic/command-center/**/*.ts' 'ship-epic/scripts/**/*.ts'",
    "format:check": "oxfmt --check 'ship-epic/command-center/**/*.ts' 'ship-epic/scripts/**/*.ts'"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teszerrakt/tz-skills.git"
  },
  "homepage": "https://github.com/teszerrakt/tz-skills#readme",
  "bugs": {
    "url": "https://github.com/teszerrakt/tz-skills/issues"
  },
  "keywords": [
    "claude-code",
    "skills",
    "claude",
    "design-docs",
    "figma",
    "standup",
    "pr-review"
  ],
  "author": "teszerrakt",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
