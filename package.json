{
  "name": "tz-skills",
  "version": "0.3.0",
  "private": true,
  "description": "teszerrakt's Claude Code skills, shipped as the tz-skills plugin.",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "bun run lint:skills && bun run typecheck && bun run lint && bun test",
    "lint:skills": "bun scripts/lint-skills.ts",
    "check:versions": "bun scripts/versions.ts",
    "evals": "bun scripts/evals.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint ship-epic/command-center ship-epic/scripts scripts",
    "format": "oxfmt 'ship-epic/command-center/**/*.ts' 'ship-epic/scripts/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "oxfmt --check 'ship-epic/command-center/**/*.ts' 'ship-epic/scripts/**/*.ts' 'scripts/**/*.ts'"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teszerrakt/tz-skills.git"
  },
  "homepage": "https://github.com/teszerrakt/tz-skills#readme",
  "bugs": {
    "url": "https://github.com/teszerrakt/tz-skills/issues"
  },
  "author": "teszerrakt",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
