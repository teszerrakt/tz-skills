{
  "description": "Keeps a T3 Code thread's title marked with ❓ while the agent's last reply ends with open questions.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt.ts\" || true",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.ts\" || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
