{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "ship-epic/command-center/**/*.ts",
    "ship-epic/scripts/**/*.ts",
    "scripts/**/*.ts",
    "figma-map/scripts/**/*.ts",
    "plugins/t3-question-marker/**/*.ts"
  ],
  "exclude": ["figma-map/scripts/figma/**"]
}
